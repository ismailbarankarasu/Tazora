<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tazora typography -->
    <Style x:Key="TazoraPageTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="TazoraSectionTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
    </Style>

    <Style x:Key="TazoraCardTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="TazoraBodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
    </Style>

    <Style x:Key="TazoraSecondaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextSecondary}" />
    </Style>

    <Style x:Key="TazoraCaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextMuted}" />
    </Style>

    <Style x:Key="TazoraPriceLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource TazoraPrimary}" />
    </Style>

    <Style x:Key="TazoraFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextSecondary}" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>

    <Style x:Key="TazoraValidationLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TazoraError}" />
        <Setter Property="Margin" Value="4,4,0,0" />
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Tazora icons -->
    <Style x:Key="TazoraIconLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TazoraPrimaryIconLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource TazoraPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Tazora buttons -->
    <Style x:Key="TazoraPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TazoraPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="TazoraOutlinedButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TazoraSurface}" />
        <Setter Property="TextColor" Value="{StaticResource TazoraPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource TazoraPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="TazoraAddButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TazoraPrimary}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Tazora form controls -->
    <Style x:Key="TazoraInputBorder" TargetType="Border">
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TazoraSurface}" />
        <Setter Property="Stroke" Value="{StaticResource TazoraBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="15" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TazoraEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TazoraTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TazoraTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>

    <!-- Tazora cards -->
    <Style x:Key="TazoraCardBorder" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource TazoraSurface}" />
        <Setter Property="Stroke" Value="{StaticResource TazoraDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
