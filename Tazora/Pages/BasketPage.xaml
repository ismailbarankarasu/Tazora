<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tazora.Pages.BasketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Tazora.Controls"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Başlık -->
        <Grid
            Grid.Row="0"
            Padding="20,20,20,12"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2">
                <Label Text="Sepetim" Style="{StaticResource TazoraPageTitleLabel}" />
                <Label
                    x:Name="BasketItemCountLabel"
                    FontSize="14"
                    Style="{StaticResource TazoraSecondaryLabel}"
                    Text="0 ürün" />
            </VerticalStackLayout>

            <Label
                Grid.Column="1"
                FontFamily="InterBold"
                FontSize="13"
                Text="Sepeti Temizle"
                TextColor="{StaticResource TazoraPrimary}"
                VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearBasketTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Ücretsiz teslimat -->
        <Border
            x:Name="FreeDeliveryBorder"
            Grid.Row="1"
            Margin="20,4,20,14"
            Padding="15"
            BackgroundColor="{StaticResource TazoraSurface}"
            Stroke="{StaticResource TazoraDivider}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="9">
                <Label
                    x:Name="FreeDeliveryLabel"
                    FontFamily="InterBold"
                    FontSize="13"
                    Text="Ücretsiz teslimat için sepetine ürün ekle"
                    TextColor="{StaticResource TazoraTextPrimary}" />

                <ProgressBar
                    x:Name="FreeDeliveryProgressBar"
                    BackgroundColor="{StaticResource TazoraDisabledBackground}"
                    Progress="0"
                    ProgressColor="{StaticResource TazoraPrimary}" />
            </VerticalStackLayout>
        </Border>

        <!-- Sepet listesi -->
        <Grid Grid.Row="2">

            <CollectionView x:Name="BasketCollectionView" Margin="20,0,20,12" VerticalScrollBarVisibility="Never">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            FontFamily="MaterialSymbols"
                            FontSize="58"
                            HorizontalOptions="Center"
                            Text="{x:Static helpers:IconFont.ShoppingCart}"
                            TextColor="{StaticResource TazoraTextMuted}" />

                        <Label
                            FontFamily="InterBold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="Sepetin henüz boş"
                            TextColor="{StaticResource TazoraTextPrimary}" />

                        <Label
                            FontFamily="InterRegular"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="Beğendiğin ürünleri sepete ekleyebilirsin."
                            TextColor="{StaticResource TazoraTextSecondary}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="10"
                            BackgroundColor="{StaticResource TazoraSurface}"
                            Stroke="{StaticResource TazoraDivider}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="92,*,Auto"
                                ColumnSpacing="12"
                                RowDefinitions="Auto,Auto,Auto">

                                <!-- Ürün görseli -->
                                <Border
                                    Grid.RowSpan="3"
                                    WidthRequest="92"
                                    HeightRequest="92"
                                    Padding="0"
                                    BackgroundColor="{StaticResource TazoraPrimarySoft}"
                                    StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Label
                                            FontFamily="MaterialSymbols"
                                            FontSize="39"
                                            HorizontalTextAlignment="Center"
                                            Text="{x:Static helpers:IconFont.ShoppingBag}"
                                            TextColor="{StaticResource TazoraPrimaryLight}"
                                            VerticalTextAlignment="Center" />

                                        <Image
                                            Aspect="AspectFill"
                                            HorizontalOptions="Fill"
                                            Source="{Binding ImageName}"
                                            VerticalOptions="Fill" />
                                    </Grid>
                                </Border>

                                <!-- Ürün adı -->
                                <Label
                                    Grid.Column="1"
                                    FontFamily="InterBold"
                                    FontSize="14"
                                    MaxLines="2"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource TazoraTextPrimary}" />

                                <!-- Sil -->
                                <Button
                                    Grid.Column="2"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    Clicked="OnRemoveClicked"
                                    CommandParameter="{Binding ProductId}"
                                    FontFamily="MaterialSymbols"
                                    FontSize="20"
                                    Text="{x:Static helpers:IconFont.Delete}"
                                    TextColor="{StaticResource TazoraTextSecondary}" />

                                <!-- Birim -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontFamily="InterRegular"
                                    FontSize="12"
                                    Text="{Binding Unit}"
                                    TextColor="{StaticResource TazoraTextSecondary}" />

                                <!-- Fiyat ve miktar -->
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    ColumnDefinitions="*,Auto"
                                    VerticalOptions="End">

                                    <Label
                                        FontFamily="InterBold"
                                        FontSize="15"
                                        Text="{Binding LineTotal, StringFormat='{0:N2} TL'}"
                                        TextColor="{StaticResource TazoraPrimary}"
                                        VerticalTextAlignment="Center" />

                                    <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                        <Button
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            BackgroundColor="{StaticResource TazoraPrimarySoft}"
                                            Clicked="OnDecreaseClicked"
                                            CommandParameter="{Binding ProductId}"
                                            CornerRadius="18"
                                            Text="−"
                                            TextColor="{StaticResource TazoraPrimary}" />

                                        <Label
                                            WidthRequest="28"
                                            FontFamily="InterBold"
                                            FontSize="14"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding Quantity}"
                                            TextColor="{StaticResource TazoraTextPrimary}"
                                            VerticalTextAlignment="Center" />

                                        <Button
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            BackgroundColor="{StaticResource TazoraPrimary}"
                                            Clicked="OnIncreaseClicked"
                                            CommandParameter="{Binding ProductId}"
                                            CornerRadius="18"
                                            Text="+"
                                            TextColor="White" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="BasketLoadingIndicator"
                WidthRequest="42"
                HeightRequest="42"
                HorizontalOptions="Center"
                IsRunning="False"
                IsVisible="False"
                VerticalOptions="Center"
                Color="{StaticResource TazoraPrimary}" />

        </Grid>

        <!-- Sipariş özeti -->
        <Border
            Grid.Row="3"
            Padding="20,14"
            BackgroundColor="{StaticResource TazoraSurface}"
            Stroke="{StaticResource TazoraDivider}">

            <VerticalStackLayout Spacing="12">

                <!-- KUPON GİRİŞ ALANI -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="{StaticResource TazoraDivider}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="CouponEntry"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing"
                            FontFamily="InterRegular"
                            FontSize="13"
                            HeightRequest="44"
                            Placeholder="Kupon Kodu Girin"
                            PlaceholderColor="{StaticResource TazoraTextMuted}"
                            TextTransform="Uppercase"
                            TextColor="{StaticResource TazoraTextPrimary}" />
                    </Border>

                    <Button
                        x:Name="ApplyCouponButton"
                        Grid.Column="1"
                        Padding="16,0"
                        BackgroundColor="{StaticResource TazoraPrimary}"
                        Clicked="OnApplyCouponClicked"
                        CornerRadius="12"
                        FontFamily="InterBold"
                        FontSize="13"
                        HeightRequest="44"
                        Text="Uygula"
                        TextColor="White" />
                </Grid>

                <!-- KUPON İNDİRİM BİLGİ DETAYI (Varsayılan olarak gizli) -->
                <Grid
                    x:Name="CouponDiscountRow"
                    ColumnDefinitions="*,Auto"
                    IsVisible="False">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label
                            FontFamily="MaterialSymbols"
                            FontSize="16"
                            Text="{x:Static helpers:IconFont.LocalOffer}"
                            TextColor="{StaticResource TazoraPrimary}" />
                        <Label
                            x:Name="CouponCodeLabel"
                            FontFamily="InterBold"
                            FontSize="13"
                            Text="KUPON"
                            TextColor="{StaticResource TazoraPrimary}" />
                        <Label
                            FontFamily="InterRegular"
                            FontSize="12"
                            Text="(İndirim Yapıldı)"
                            TextColor="{StaticResource TazoraTextSecondary}" />
                    </HorizontalStackLayout>

                    <Label
                        x:Name="CouponRemoveLabel"
                        Grid.Column="1"
                        FontFamily="InterBold"
                        FontSize="12"
                        Text="Kaldır"
                        TextColor="{StaticResource TazoraError}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRemoveCouponTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView 
                    HeightRequest="1" 
                    Color="{StaticResource TazoraDivider}" 
                    HorizontalOptions="Fill" />

                <!-- TOPLAM BİLGİSİ VE TAMAMLA BUTONU -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="1">
                        <Label
                            FontFamily="InterRegular"
                            FontSize="12"
                            Text="Ödenecek Tutar"
                            TextColor="{StaticResource TazoraTextSecondary}" />

                        <Label
                            x:Name="BasketTotalLabel"
                            FontFamily="InterBold"
                            FontSize="21"
                            Text="0,00 TL"
                            TextColor="{StaticResource TazoraTextPrimary}" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="CheckoutButton"
                        Grid.Column="1"
                        Padding="22,0"
                        Clicked="OnCheckoutClicked"
                        HeightRequest="52"
                        Style="{StaticResource TazoraPrimaryButton}"
                        Text="Siparişi Tamamla" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <controls:BottomNavigationBar
            Grid.Row="4"
            ActiveTab="Basket"
            HorizontalOptions="Fill" />

    </Grid>
</ContentPage>