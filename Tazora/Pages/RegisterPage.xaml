<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tazora.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    BackgroundColor="{StaticResource TazoraPrimary}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Top App Bar Section -->
        <Grid
            Grid.Row="0"
            HeightRequest="70"
            Padding="16,8"
            ColumnDefinitions="48,*,48">

            <!-- Back Icon Button -->
            <Border
                Grid.Column="0"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                StrokeThickness="0"
                BackgroundColor="#20FFFFFF"
                HorizontalOptions="Start"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Label
                    Text="{x:Static helpers:IconFont.ArrowBack}"
                    FontFamily="MaterialSymbols"
                    FontSize="24"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Top Header Text -->
            <Label
                Grid.Column="1"
                Text="Kayıt Ol"
                FontFamily="InterBold"
                FontSize="20"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- Register Form Container -->
        <Border
            Grid.Row="1"
            Padding="24,28,24,20"
            BackgroundColor="{StaticResource TazoraBackground}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32,32,0,0" />
            </Border.StrokeShape>

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">

                    <!-- Title -->
                    <Label
                        Text="Aramıza Katılın 👋"
                        FontFamily="InterBold"
                        FontSize="24"
                        TextColor="{StaticResource TazoraTextPrimary}" />

                    <Label
                        Text="Hızlı teslimatın ve taze ürünlerin tadını çıkarın"
                        FontFamily="InterRegular"
                        FontSize="13"
                        TextColor="{StaticResource TazoraTextSecondary}"
                        Margin="0,4,0,20" />

                    <!-- Full Name Field -->
                    <Label
                        Text="Ad Soyad"
                        Style="{StaticResource TazoraFieldLabel}" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Person}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="FullNameEntry"
                                Grid.Column="1"
                                Placeholder="Örn. Ahmet Yılmaz"
                                ReturnType="Next"
                                Style="{StaticResource TazoraEntry}"
                                ClearButtonVisibility="Never" />
                        </Grid>
                    </Border>

                    <Label
                        x:Name="FullNameErrorLabel"
                        Text="Ad soyad alanı zorunludur."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Email Field -->
                    <Label
                        Text="E-posta"
                        Style="{StaticResource TazoraFieldLabel}"
                        Margin="0,10,0,6" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Email}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="EmailEntry"
                                Grid.Column="1"
                                Placeholder="ornek@mail.com"
                                Keyboard="Email"
                                ReturnType="Next"
                                Style="{StaticResource TazoraEntry}"
                                ClearButtonVisibility="Never" />
                        </Grid>
                    </Border>

                    <Label
                        x:Name="EmailErrorLabel"
                        Text="Geçerli bir e-posta adresi gir."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Phone Field -->
                    <Label
                        Text="Telefon Numarası"
                        Style="{StaticResource TazoraFieldLabel}"
                        Margin="0,10,0,6" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Phone}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="PhoneEntry"
                                Grid.Column="1"
                                Placeholder="05XX XXX XX XX"
                                Keyboard="Telephone"
                                MaxLength="15"
                                ReturnType="Next"
                                Style="{StaticResource TazoraEntry}"
                                ClearButtonVisibility="Never" />
                        </Grid>
                    </Border>

                    <Label
                        x:Name="PhoneErrorLabel"
                        Text="Geçerli bir telefon numarası gir."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Password Field -->
                    <Label
                        Text="Şifre"
                        Style="{StaticResource TazoraFieldLabel}"
                        Margin="0,10,0,6" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*,44">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Lock}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="PasswordEntry"
                                Grid.Column="1"
                                Placeholder="En az 8 karakter"
                                IsPassword="True"
                                ReturnType="Done"
                                Style="{StaticResource TazoraEntry}"
                                ClearButtonVisibility="Never" />

                            <Label
                                x:Name="PasswordVisibilityIcon"
                                Grid.Column="2"
                                Text="{x:Static helpers:IconFont.VisibilityOff}"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                TextColor="{StaticResource TazoraTextMuted}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPasswordVisibilityTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <Label
                        x:Name="PasswordErrorLabel"
                        Text="Şifre en az 8 karakter olmalıdır."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Terms Checkbox -->
                    <Grid ColumnDefinitions="32,*" Margin="0,16,0,0">
                        <CheckBox
                            x:Name="TermsCheckBox"
                            Grid.Column="0"
                            Color="{StaticResource TazoraPrimary}"
                            VerticalOptions="Center"
                            Margin="-6,0,0,0" />

                        <Label
                            Grid.Column="1"
                            FontFamily="InterRegular"
                            FontSize="12"
                            TextColor="{StaticResource TazoraTextSecondary}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Kullanım Koşulları ve " />
                                    <Span
                                        Text="Gizlilik Politikası"
                                        TextColor="{StaticResource TazoraPrimary}"
                                        FontFamily="InterBold" />
                                    <Span Text="'nı okudum ve kabul ediyorum." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Label
                        x:Name="TermsErrorLabel"
                        Text="Devam etmek için kullanım koşullarını kabul etmelisin."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Register Button -->
                    <Button
                        x:Name="RegisterButton"
                        Text="Kayıt Ol"
                        Clicked="OnRegisterClicked"
                        Style="{StaticResource TazoraPrimaryButton}"
                        HeightRequest="52"
                        Margin="0,20,0,0" />

                    <ActivityIndicator
                        x:Name="RegisterActivityIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="{StaticResource TazoraPrimary}"
                        HeightRequest="32"
                        Margin="0,10,0,0" />

                    <!-- Existing User Redirection -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="5"
                        Margin="0,20,0,16">

                        <Label
                            Text="Zaten hesabın var mı?"
                            FontFamily="InterRegular"
                            FontSize="14"
                            TextColor="{StaticResource TazoraTextSecondary}" />

                        <Label
                            x:Name="GoToLoginLabel"
                            Text="Giriş Yap"
                            FontFamily="InterBold"
                            FontSize="14"
                            TextColor="{StaticResource TazoraPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoToLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>