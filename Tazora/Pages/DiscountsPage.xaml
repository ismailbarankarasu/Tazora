<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Tazora.Pages.DiscountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    xmlns:controls="clr-namespace:Tazora.Controls"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Başlık -->
        <Grid
            Grid.Row="0"
            Padding="18,20,18,12"
            ColumnDefinitions="44,*,44">

            <Label
                Text="{x:Static helpers:IconFont.ArrowBack}"
                FontFamily="MaterialSymbols"
                FontSize="28"
                TextColor="{StaticResource TazoraTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                Grid.Column="1"
                Text="İndirimler"
                FontFamily="InterBold"
                FontSize="23"
                TextColor="{StaticResource TazoraPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

            <Label
                Grid.Column="2"
                Text="{x:Static helpers:IconFont.LocalOffer}"
                FontFamily="MaterialSymbols"
                FontSize="26"
                TextColor="{StaticResource TazoraPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        <Label
            x:Name="DiscountCountLabel"
            Grid.Row="1"
            Text="İndirimler yükleniyor..."
            Margin="20,4,20,12"
            FontFamily="InterRegular"
            FontSize="13"
            TextColor="{StaticResource TazoraTextSecondary}" />

        <!-- İndirimli ürünler -->
        <Grid Grid.Row="2">

            <CollectionView
                x:Name="DiscountsCollectionView"
                Margin="20,0,20,16"
                SelectionMode="Single"
                SelectionChanged="OnProductSelectionChanged"
                VerticalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="14"
                        VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Spacing="9"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="{x:Static helpers:IconFont.LocalOffer}"
                            FontFamily="MaterialSymbols"
                            FontSize="55"
                            TextColor="{StaticResource TazoraTextMuted}"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Aktif indirim bulunmuyor"
                            FontFamily="InterBold"
                            FontSize="16"
                            TextColor="{StaticResource TazoraTextPrimary}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            HeightRequest="310"
                            Padding="10"
                            BackgroundColor="{StaticResource TazoraSurface}"
                            Stroke="{StaticResource TazoraDivider}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                RowDefinitions="135,Auto,18,Auto,Auto,*,42"
                                RowSpacing="6">

                                <Grid Grid.Row="0">

                                    <Border
                                        BackgroundColor="{StaticResource TazoraPrimarySoft}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Grid>

                                            <Label
                                                Text="{x:Static helpers:IconFont.ShoppingBag}"
                                                FontFamily="MaterialSymbols"
                                                FontSize="48"
                                                TextColor="{StaticResource TazoraPrimaryLight}"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                            <Image
                                                Source="{Binding ImageName}"
                                                Aspect="AspectFill"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill" />

                                        </Grid>

                                    </Border>

                                    <Border
                                        Margin="7"
                                        Padding="8,4"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource TazoraDiscount}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding DiscountText}"
                                            FontFamily="InterBold"
                                            FontSize="11"
                                            TextColor="White" />

                                    </Border>

                                    <Label
                                        Text="{x:Static helpers:IconFont.FavoriteBorder}"
                                        FontFamily="MaterialSymbols"
                                        FontSize="25"
                                        TextColor="{StaticResource TazoraTextSecondary}"
                                        Margin="7"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start" />

                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding DiscountedPrice, StringFormat='{0:N2} TL'}"
                                    Style="{StaticResource TazoraPriceLabel}" />

                                <Label
                                    Grid.Row="2"
                                    Text="{Binding Price, StringFormat='{0:N2} TL'}"
                                    FontFamily="InterRegular"
                                    FontSize="11"
                                    TextDecorations="Strikethrough"
                                    TextColor="{StaticResource TazoraTextMuted}" />

                                <Label
                                    Grid.Row="3"
                                    Text="{Binding Name}"
                                    FontFamily="InterBold"
                                    FontSize="14"
                                    TextColor="{StaticResource TazoraTextPrimary}"
                                    MaxLines="2" />

                                <Label
                                    Grid.Row="4"
                                    Text="{Binding Unit}"
                                    FontFamily="InterRegular"
                                    FontSize="12"
                                    TextColor="{StaticResource TazoraTextSecondary}" />

                                <Button
                                    Grid.Row="6"
                                    Text="+ Ekle"
                                    Style="{StaticResource TazoraAddButton}"
                                    HeightRequest="42"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnAddToBasketClicked" />

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="DiscountLoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                WidthRequest="44"
                HeightRequest="44"
                Color="{StaticResource TazoraPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <controls:BottomNavigationBar
            Grid.Row="3"
            ActiveTab="Home"
            HorizontalOptions="Fill" />

    </Grid>
</ContentPage>