<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tazora.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    BackgroundColor="{StaticResource TazoraPrimary}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header / Hero Section -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,40,24,32"
            Spacing="12"
            HorizontalOptions="Center">

            <!-- App Logo Badge -->
            <Border
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                StrokeThickness="0"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#30000000" Offset="0,8" Radius="16" />
                </Border.Shadow>

                <Label
                    Text="{x:Static helpers:IconFont.ShoppingCart}"
                    FontFamily="MaterialSymbols"
                    FontSize="38"
                    TextColor="{StaticResource TazoraPrimary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Text="Tazora"
                FontFamily="InterBold"
                FontSize="30"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Taptaze lezzetler kapına gelsin"
                FontFamily="InterRegular"
                FontSize="14"
                TextColor="#E0F2FE"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Form Section Container (Bottom Sheet Style) -->
        <Border
            Grid.Row="1"
            Padding="24,28,24,20"
            BackgroundColor="{StaticResource TazoraBackground}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32,32,0,0" />
            </Border.StrokeShape>

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">

                    <!-- Title -->
                    <Label
                        Text="Hoş Geldiniz"
                        FontFamily="InterBold"
                        FontSize="24"
                        TextColor="{StaticResource TazoraTextPrimary}" />

                    <Label
                        Text="Devam etmek için hesabınıza giriş yapın"
                        FontFamily="InterRegular"
                        FontSize="13"
                        TextColor="{StaticResource TazoraTextSecondary}"
                        Margin="0,4,0,24" />

                    <!-- Email Input -->
                    <Label
                        Text="E-posta Adresi"
                        Style="{StaticResource TazoraFieldLabel}" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*,40">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Email}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="EmailEntry"
                                Grid.Column="1"
                                Placeholder="ornek@mail.com"
                                Keyboard="Email"
                                ReturnType="Next"
                                ClearButtonVisibility="Never"
                                Style="{StaticResource TazoraEntry}" />
                        </Grid>
                    </Border>

                    <Label
                        x:Name="EmailErrorLabel"
                        Text="Geçerli bir e-posta adresi gir."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Password Input -->
                    <Label
                        Text="Şifre"
                        Style="{StaticResource TazoraFieldLabel}"
                        Margin="0,12,0,6" />

                    <Border Style="{StaticResource TazoraInputBorder}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40,*,44">
                            <Label
                                Grid.Column="0"
                                Text="{x:Static helpers:IconFont.Lock}"
                                FontFamily="MaterialSymbols"
                                FontSize="20"
                                TextColor="{StaticResource TazoraPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="PasswordEntry"
                                Grid.Column="1"
                                Placeholder="••••••••"
                                IsPassword="True"
                                ReturnType="Done"
                                ClearButtonVisibility="Never"
                                Style="{StaticResource TazoraEntry}"
                                Completed="OnPasswordCompleted" />

                            <Label
                                x:Name="PasswordVisibilityIcon"
                                Grid.Column="2"
                                Text="{x:Static helpers:IconFont.VisibilityOff}"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                TextColor="{StaticResource TazoraTextMuted}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPasswordVisibilityTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <Label
                        x:Name="PasswordErrorLabel"
                        Text="Şifre alanı zorunludur."
                        Style="{StaticResource TazoraValidationLabel}" />

                    <!-- Error Alert Box -->
                    <Border
                        x:Name="LoginErrorBorder"
                        IsVisible="False"
                        Margin="0,12,0,0"
                        Padding="14,10"
                        BackgroundColor="#FDECEC"
                        Stroke="{StaticResource TazoraError}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="10">
                            <Label
                                Text="!"
                                FontFamily="InterBold"
                                FontSize="15"
                                TextColor="{StaticResource TazoraError}"
                                VerticalTextAlignment="Center" />
                            <Label
                                x:Name="LoginErrorLabel"
                                Text="E-posta veya şifre hatalı."
                                FontFamily="InterRegular"
                                FontSize="13"
                                TextColor="{StaticResource TazoraError}"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Submit Button -->
                    <Button
                        x:Name="LoginButton"
                        Text="Giriş Yap"
                        Clicked="OnLoginClicked"
                        Style="{StaticResource TazoraPrimaryButton}"
                        HeightRequest="52"
                        Margin="0,24,0,0" />

                    <ActivityIndicator
                        x:Name="LoginActivityIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        HeightRequest="34"
                        Color="{StaticResource TazoraPrimary}"
                        Margin="0,10,0,0" />

                    <!-- Bottom Register Redirection -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="5"
                        Margin="0,28,0,16">

                        <Label
                            Text="Hesabın yok mu?"
                            FontFamily="InterRegular"
                            FontSize="14"
                            TextColor="{StaticResource TazoraTextSecondary}" />

                        <Label
                            Text="Hemen Kayıt Ol"
                            FontFamily="InterBold"
                            FontSize="14"
                            TextColor="{StaticResource TazoraPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoToRegisterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>