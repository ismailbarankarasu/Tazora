<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Tazora.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Tazora.Controls"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Mevcut kategori sayfası içeriği -->
        <Grid Grid.Row="0">

            <Label
            Text="Kategoriler"
            Style="{StaticResource TazoraPageTitleLabel}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        </Grid>

        <controls:BottomNavigationBar
        Grid.Row="1"
        ActiveTab="Categories"
        HorizontalOptions="Fill" />

    </Grid>
</ContentPage>