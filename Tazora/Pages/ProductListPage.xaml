<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Tazora.Pages.ProductListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    xmlns:controls="clr-namespace:Tazora.Controls"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Başlık -->
        <Grid
            Grid.Row="0"
            Padding="18,20,18,10"
            ColumnDefinitions="44,*,44">

            <Label
                Text="{x:Static helpers:IconFont.ArrowBack}"
                FontFamily="MaterialSymbols"
                FontSize="28"
                TextColor="{StaticResource TazoraTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                x:Name="CategoryTitleLabel"
                Grid.Column="1"
                Text="Ürünler"
                FontFamily="InterBold"
                FontSize="23"
                TextColor="{StaticResource TazoraPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

            <Label
                Grid.Column="2"
                Text="{x:Static helpers:IconFont.Search}"
                FontFamily="MaterialSymbols"
                FontSize="25"
                TextColor="{StaticResource TazoraTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        <!-- Arama -->
        <Border
            Grid.Row="1"
            HeightRequest="52"
            Margin="20,8,20,0"
            Padding="14,0"
            BackgroundColor="{StaticResource TazoraSurface}"
            Stroke="{StaticResource TazoraBorder}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="34,*">

                <Label
                    Text="{x:Static helpers:IconFont.Search}"
                    FontFamily="MaterialSymbols"
                    FontSize="22"
                    TextColor="{StaticResource TazoraTextSecondary}"
                    VerticalTextAlignment="Center" />

                <Entry
                    Grid.Column="1"
                    Placeholder="Ürün ara"
                    FontFamily="InterRegular"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextChanged="OnSearchTextChanged" />

            </Grid>
        </Border>

        <!-- Ürün sayısı -->
        <Label
            x:Name="ProductCountLabel"
            Grid.Row="2"
            Text="Ürünler yükleniyor..."
            Margin="20,15,20,10"
            FontFamily="InterRegular"
            FontSize="13"
            TextColor="{StaticResource TazoraTextSecondary}" />

        <!-- Ürün listesi -->
        <Grid Grid.Row="3">

            <CollectionView
                x:Name="ProductsCollectionView"
                Margin="20,4,20,16"
                VerticalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="14"
                        VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="{x:Static helpers:IconFont.Search}"
                            FontFamily="MaterialSymbols"
                            FontSize="42"
                            TextColor="{StaticResource TazoraTextMuted}"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Ürün bulunamadı"
                            FontFamily="InterBold"
                            FontSize="15"
                            TextColor="{StaticResource TazoraTextSecondary}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            HeightRequest="310"
                            Padding="10"
                            BackgroundColor="{StaticResource TazoraSurface}"
                            Stroke="{StaticResource TazoraDivider}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <!-- Ürün görsel alanı -->
                                <Grid HeightRequest="135">

                                    <Border
                                        BackgroundColor="{StaticResource TazoraPrimarySoft}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{x:Static helpers:IconFont.ShoppingBag}"
                                            FontFamily="MaterialSymbols"
                                            FontSize="48"
                                            TextColor="{StaticResource TazoraPrimaryLight}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <Border
                                        IsVisible="{Binding HasDiscount}"
                                        Margin="7"
                                        Padding="8,4"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource TazoraDiscount}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding DiscountText}"
                                            FontFamily="InterBold"
                                            FontSize="11"
                                            TextColor="White" />

                                    </Border>

                                    <Label
                                        Text="{x:Static helpers:IconFont.FavoriteBorder}"
                                        FontFamily="MaterialSymbols"
                                        FontSize="25"
                                        TextColor="{StaticResource TazoraTextSecondary}"
                                        Margin="7"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start" />

                                </Grid>

                                <Label
                                    Text="{Binding DiscountedPrice, StringFormat='{0:N2} TL'}"
                                    Style="{StaticResource TazoraPriceLabel}" />

                                <Label
                                    Text="{Binding Price, StringFormat='{0:N2} TL'}"
                                    IsVisible="{Binding HasDiscount}"
                                    FontFamily="InterRegular"
                                    FontSize="11"
                                    TextDecorations="Strikethrough"
                                    TextColor="{StaticResource TazoraTextMuted}" />

                                <Label
                                    Text="{Binding Name}"
                                    FontFamily="InterBold"
                                    FontSize="14"
                                    TextColor="{StaticResource TazoraTextPrimary}"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding Unit}"
                                    FontFamily="InterRegular"
                                    FontSize="12"
                                    TextColor="{StaticResource TazoraTextSecondary}" />

                                <Button
                                    Grid.Row="6"
                                    Text="+ Ekle"
                                    Style="{StaticResource TazoraAddButton}"
                                    HeightRequest="42"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnAddToBasketClicked"/>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="ProductLoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                WidthRequest="42"
                HeightRequest="42"
                Color="{StaticResource TazoraPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Border
                x:Name="ProductErrorBorder"
                IsVisible="False"
                Margin="20"
                Padding="16"
                BackgroundColor="#FDECEC"
                Stroke="{StaticResource TazoraError}"
                VerticalOptions="Start">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Label
                    Text="Ürünler yüklenemedi. Lütfen tekrar dene."
                    FontFamily="InterRegular"
                    FontSize="13"
                    TextColor="{StaticResource TazoraError}" />

            </Border>

        </Grid>

        <controls:BottomNavigationBar
            Grid.Row="4"
            ActiveTab="Categories"
            HorizontalOptions="Fill" />

    </Grid>
</ContentPage>