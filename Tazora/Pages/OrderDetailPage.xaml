<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Tazora.Pages.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    xmlns:controls="clr-namespace:Tazora.Controls"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Başlık -->
        <Grid
            Grid.Row="0"
            Padding="18,20,18,14"
            ColumnDefinitions="44,*,44">

            <Label
                Text="{x:Static helpers:IconFont.ArrowBack}"
                FontFamily="MaterialSymbols"
                FontSize="28"
                TextColor="{StaticResource TazoraTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                x:Name="OrderNumberLabel"
                Grid.Column="1"
                Text="Sipariş Detayı"
                FontFamily="InterBold"
                FontSize="22"
                TextColor="{StaticResource TazoraPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        <!-- Sipariş durumu -->
        <Border
            Grid.Row="1"
            Margin="20,0,20,14"
            Padding="16"
            BackgroundColor="{StaticResource TazoraSurface}"
            Stroke="{StaticResource TazoraDivider}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="50,*,Auto">

                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource TazoraPrimarySoft}"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Label
                        Text="{x:Static helpers:IconFont.Receipt}"
                        FontFamily="MaterialSymbols"
                        FontSize="25"
                        TextColor="{StaticResource TazoraPrimary}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Label
                        x:Name="OrderStatusLabel"
                        Text="Hazırlanıyor"
                        FontFamily="InterBold"
                        FontSize="15"
                        TextColor="{StaticResource TazoraPrimary}" />

                    <Label
                        x:Name="OrderDateLabel"
                        Text="Sipariş tarihi"
                        FontFamily="InterRegular"
                        FontSize="12"
                        TextColor="{StaticResource TazoraTextSecondary}" />

                </VerticalStackLayout>

                <Label
                    Grid.Column="2"
                    Text="{x:Static helpers:IconFont.ChevronRight}"
                    FontFamily="MaterialSymbols"
                    FontSize="24"
                    TextColor="{StaticResource TazoraTextMuted}"
                    VerticalTextAlignment="Center" />

            </Grid>
        </Border>

        <!-- Sipariş ürünleri -->
        <CollectionView
            x:Name="OrderItemsCollectionView"
            Grid.Row="2"
            Margin="20,0,20,12"
            VerticalScrollBarVisibility="Never">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        BackgroundColor="{StaticResource TazoraSurface}"
                        Stroke="{StaticResource TazoraDivider}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="68,*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="12">

                            <Border
                                WidthRequest="72"
                                HeightRequest="72"
                                Padding="0"
                                BackgroundColor="{StaticResource TazoraPrimarySoft}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>

                                    <Label
                                        Text="{x:Static helpers:IconFont.ShoppingBag}"
                                        FontFamily="MaterialSymbols"
                                        FontSize="30"
                                        TextColor="{StaticResource TazoraPrimaryLight}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                    <Image
                                        Source="{Binding ImageName}"
                                        Aspect="AspectFill"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />

                                </Grid>
                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding ProductName}"
                                FontFamily="InterBold"
                                FontSize="14"
                                TextColor="{StaticResource TazoraTextPrimary}"
                                MaxLines="2" />

                            <Label
                                Grid.Column="2"
                                Text="{Binding TotalPrice, StringFormat='{0:N2} TL'}"
                                FontFamily="InterBold"
                                FontSize="14"
                                TextColor="{StaticResource TazoraPrimary}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Quantity, StringFormat='{0} adet'}"
                                FontFamily="InterRegular"
                                FontSize="12"
                                TextColor="{StaticResource TazoraTextSecondary}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="{Binding UnitPrice, StringFormat='{0:N2} TL / adet'}"
                                FontFamily="InterRegular"
                                FontSize="11"
                                TextColor="{StaticResource TazoraTextMuted}" />

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Fiyat özeti -->
        <Border
            Grid.Row="3"
            Margin="20,0,20,12"
            Padding="16"
            BackgroundColor="{StaticResource TazoraSurface}"
            Stroke="{StaticResource TazoraDivider}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="17" />
            </Border.StrokeShape>

            <Grid
                RowDefinitions="Auto,Auto,Auto,1,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="8">

                <Label
                    Text="Ara toplam"
                    Style="{StaticResource TazoraSecondaryLabel}"
                    FontSize="13" />

                <Label
                    x:Name="SubtotalLabel"
                    Grid.Column="1"
                    Text="0,00 TL"
                    FontFamily="InterRegular"
                    FontSize="13" />

                <Label
                    Grid.Row="1"
                    Text="İndirim"
                    Style="{StaticResource TazoraSecondaryLabel}"
                    FontSize="13" />

                <Label
                    x:Name="DiscountAmountLabel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="-0,00 TL"
                    FontFamily="InterRegular"
                    FontSize="13"
                    TextColor="{StaticResource TazoraPrimary}" />

                <Label
                    Grid.Row="2"
                    Text="Teslimat"
                    Style="{StaticResource TazoraSecondaryLabel}"
                    FontSize="13" />

                <Label
                    x:Name="DeliveryFeeLabel"
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="0,00 TL"
                    FontFamily="InterRegular"
                    FontSize="13" />

                <BoxView
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    BackgroundColor="{StaticResource TazoraDivider}" />

                <Label
                    Grid.Row="4"
                    Text="Toplam"
                    FontFamily="InterBold"
                    FontSize="16"
                    TextColor="{StaticResource TazoraTextPrimary}" />

                <Label
                    x:Name="TotalAmountLabel"
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="0,00 TL"
                    FontFamily="InterBold"
                    FontSize="18"
                    TextColor="{StaticResource TazoraPrimary}" />

            </Grid>
        </Border>

        <controls:BottomNavigationBar
            Grid.Row="4"
            ActiveTab="Profile"
            HorizontalOptions="Fill" />

        <ActivityIndicator
            x:Name="OrderLoadingIndicator"
            Grid.RowSpan="5"
            IsVisible="False"
            IsRunning="False"
            WidthRequest="44"
            HeightRequest="44"
            Color="{StaticResource TazoraPrimary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>