<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tazora.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Tazora.Controls"
    xmlns:helpers="clr-namespace:Tazora.Helpers"
    BackgroundColor="{StaticResource TazoraBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="20,20,20,28" Spacing="18">

                <!-- Başlık -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Profilim" Style="{StaticResource TazoraPageTitleLabel}" />

                    <Label
                        Grid.Column="1"
                        FontFamily="MaterialSymbols"
                        FontSize="27"
                        Text="{x:Static helpers:IconFont.Settings}"
                        TextColor="{StaticResource TazoraPrimary}"
                        VerticalTextAlignment="Center" />
                </Grid>

                <!-- Kullanıcı Kartı -->
                <Border
                    Padding="20"
                    BackgroundColor="{StaticResource TazoraSurface}"
                    Stroke="{StaticResource TazoraDivider}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <VerticalStackLayout HorizontalOptions="Center" Spacing="9">
                        <Border
                            WidthRequest="86"
                            HeightRequest="86"
                            Padding="0"
                            BackgroundColor="{StaticResource TazoraPrimarySoft}"
                            Stroke="{StaticResource TazoraPrimary}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="43" />
                            </Border.StrokeShape>

                            <Label
                                FontFamily="MaterialSymbols"
                                FontSize="43"
                                HorizontalTextAlignment="Center"
                                Text="{x:Static helpers:IconFont.Person}"
                                TextColor="{StaticResource TazoraPrimary}"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <Label
                            x:Name="ProfileNameLabel"
                            FontFamily="InterBold"
                            FontSize="21"
                            HorizontalTextAlignment="Center"
                            Text="Kullanıcı"
                            TextColor="{StaticResource TazoraTextPrimary}" />

                        <Label
                            x:Name="ProfileContactLabel"
                            FontFamily="InterRegular"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="kullanici@mail.com"
                            TextColor="{StaticResource TazoraTextSecondary}" />

                        <Button
                            Margin="0,5,0,0"
                            Padding="22,0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource TazoraPrimary}"
                            BorderWidth="1"
                            Clicked="OnEditProfileClicked"
                            CornerRadius="20"
                            FontFamily="InterBold"
                            FontSize="13"
                            HeightRequest="42"
                            Text="Profili Düzenle"
                            TextColor="{StaticResource TazoraPrimary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- İstatistikler -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        Padding="10,14"
                        BackgroundColor="{StaticResource TazoraSurface}"
                        Stroke="{StaticResource TazoraDivider}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label
                                FontFamily="MaterialSymbols"
                                FontSize="25"
                                HorizontalOptions="Center"
                                Text="{x:Static helpers:IconFont.Receipt}"
                                TextColor="{StaticResource TazoraPrimary}" />
                            <Label
                                x:Name="OrderCountLabel"
                                FontFamily="InterBold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="0"
                                TextColor="{StaticResource TazoraTextPrimary}" />
                            <Label
                                FontFamily="InterRegular"
                                FontSize="11"
                                Text="Sipariş"
                                TextColor="{StaticResource TazoraTextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="10,14"
                        BackgroundColor="{StaticResource TazoraSurface}"
                        Stroke="{StaticResource TazoraDivider}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label
                                FontFamily="MaterialSymbols"
                                FontSize="25"
                                HorizontalOptions="Center"
                                Text="{x:Static helpers:IconFont.ShoppingCart}"
                                TextColor="{StaticResource TazoraPrimary}" />
                            <Label
                                x:Name="BasketCountLabel"
                                FontFamily="InterBold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="0"
                                TextColor="{StaticResource TazoraTextPrimary}" />
                            <Label
                                FontFamily="InterRegular"
                                FontSize="11"
                                Text="Sepet"
                                TextColor="{StaticResource TazoraTextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="10,14"
                        BackgroundColor="{StaticResource TazoraSurface}"
                        Stroke="{StaticResource TazoraDivider}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label
                                FontFamily="MaterialSymbols"
                                FontSize="25"
                                HorizontalOptions="Center"
                                Text="{x:Static helpers:IconFont.LocalOffer}"
                                TextColor="{StaticResource TazoraPrimary}" />
                            <Label
                                x:Name="DiscountCountLabel"
                                FontFamily="InterBold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="0"
                                TextColor="{StaticResource TazoraTextPrimary}" />
                            <Label
                                FontFamily="InterRegular"
                                FontSize="11"
                                Text="İndirim"
                                TextColor="{StaticResource TazoraTextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- YENİ EKLENEN: Fırsat Çarkı / İndirim Kazan Butonu -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{StaticResource TazoraPrimarySoft}"
                    Stroke="{StaticResource TazoraPrimary}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSpinWheelTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                        <Border
                            Grid.Column="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource TazoraPrimary}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{x:Static helpers:IconFont.LocalOffer}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label
                                FontFamily="InterBold"
                                FontSize="14"
                                Text="Fırsat Çarkı - İndirim Kazan 🎁"
                                TextColor="{StaticResource TazoraPrimary}" />
                            <Label
                                FontFamily="InterRegular"
                                FontSize="11"
                                Text="Çarkı çevir, sürpriz kuponları kap!"
                                TextColor="{StaticResource TazoraTextSecondary}" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            FontFamily="MaterialSymbols"
                            FontSize="22"
                            Text="{x:Static helpers:IconFont.ChevronRight}"
                            TextColor="{StaticResource TazoraPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label
                    Margin="0,4,0,0"
                    Style="{StaticResource TazoraSectionTitleLabel}"
                    Text="Hesabım" />

                <!-- Menü Container -->
                <VerticalStackLayout x:Name="ProfileMenuContainer" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="15"
                                BackgroundColor="{StaticResource TazoraSurface}"
                                Stroke="{StaticResource TazoraDivider}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding Key}" Tapped="OnMenuItemTapped" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="40,*,Auto">
                                    <Label
                                        FontFamily="MaterialSymbols"
                                        FontSize="24"
                                        Text="{Binding Icon}"
                                        TextColor="{StaticResource TazoraPrimary}"
                                        VerticalTextAlignment="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            FontFamily="InterBold"
                                            FontSize="14"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource TazoraTextPrimary}" />
                                        <Label
                                            FontFamily="InterRegular"
                                            FontSize="11"
                                            Text="{Binding Subtitle}"
                                            TextColor="{StaticResource TazoraTextSecondary}" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        FontFamily="MaterialSymbols"
                                        FontSize="23"
                                        Text="{x:Static helpers:IconFont.ChevronRight}"
                                        TextColor="{StaticResource TazoraTextMuted}"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Çıkış Yap Butonu -->
                <Button
                    BackgroundColor="#FDECEC"
                    BorderColor="{StaticResource TazoraError}"
                    BorderWidth="1"
                    Clicked="OnLogoutClicked"
                    CornerRadius="16"
                    FontFamily="InterBold"
                    FontSize="14"
                    HeightRequest="50"
                    Text="Çıkış Yap"
                    TextColor="{StaticResource TazoraError}" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavigationBar
            Grid.Row="1"
            ActiveTab="Profile"
            HorizontalOptions="Fill" />

    </Grid>
</ContentPage>